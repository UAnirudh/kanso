# ---------------------------------------------------------------------------
# Kanso environment configuration
# Copy to .env.local and fill in what you have.
# ---------------------------------------------------------------------------

# SQLite database file (relative to the project root or absolute).
# The schema is written in portable SQL; see ARCHITECTURE.md for the Postgres path.
DATABASE_PATH=.data/kanso.db

# Public origin of the app. Used for cookie defaults and documentation links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI provider (optional) -------------------------------------------------
# Without a key the platform still works: the interface assistant falls back to
# the deterministic local planner, clearly labelled in the UI.
GROQ_API_KEY=
# Verified Groq model id. Groq does not offer "Qwen 3.7"; qwen/qwen3-32b is the
# stable Qwen option, qwen/qwen3.6-27b and qwen/qwen3.8-27b exist as newer variants.
GROQ_MODEL=qwen/qwen3-32b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Request budget per user per minute for AI interface edits.
AI_RATE_LIMIT_PER_MINUTE=8
# Upstream request timeout in milliseconds.
AI_TIMEOUT_MS=25000
